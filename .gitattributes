# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf

# Binary payloads must never be rewritten
*.bin   binary
*.hex   binary
*.elf   binary
*.png   binary
*.jpg   binary
